+#if PHP_VERSION_ID < 80600
 #define YAF_ME(c, m, a, f)              {m, PHP_MN(c), a, (unsigned)(sizeof(a)/sizeof(struct _zend_arg_info)-1), f},
+#else
+/* PHP 8.6 起 zend_function_entry 的 flags 变为 uint64_t 并新增 frameless_function_infos,
